[resource]
script = ExtResource("1_ijq31")
text = "#version 450

layout(location = 0) in vec2 v_uv;
layout(location = 0) out vec4 outColor;

@DECLARATIONS
@BVH_UTILS
@BVH_TRAVERSAL

void main() {
	vec2 uv = v_uv;
	vec2 texel = 1.0 / vec2(textureSize(position_map,0));
	vec3 P = texture(position_map,v_uv).xyz;
	vec3 N = normalize(texture(normal_map,v_uv).xyz);
	@SAMPLE_KERNEL	
}"
