[ext_resource type="Script" uid="uid://bc3eljtuurjsd" path="res://addons/material_maker/engine/text_resource.gd" id="1_0bvqj"]

[resource]
script = ExtResource("1_0bvqj")
text = "#version 450

layout(location = 0) out vec2 uv;

void main() {
	vec2 verts[3] = vec2[](
		vec2(-1.0,-1.0),
		vec2( 3.0,-1.0),
		vec2(-1.0,3.0)
	);	

	vec2 pos = verts[gl_VertexIndex];
	uv = pos *0.5 + 0.5;
	gl_Position = vec4(pos,0.0,1.0);
}
"
