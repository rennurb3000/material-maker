[ext_resource type="Script" uid="uid://bc3eljtuurjsd" path="res://addons/material_maker/engine/text_resource.gd" id="1_puend"]

[resource]
script = ExtResource("1_puend")
text = "// Note: two fixes: sample at texel center to get rid of uv seams
// use texturelod instead of texture, that fixed a crash for some reason
#version 450

layout(local_size_x = @LOCAL_SIZE, local_size_y = 1, local_size_z = 1) in;

@DECLARATIONS

layout(set = 3, binding = 0, std140) restrict buffer MM {
	int mm_chunk_y;
};

void main() {
	
	ivec2 pixel = ivec2(gl_GlobalInvocationID.xy)+ivec2(0, mm_chunk_y);
	vec2 image_size = imageSize(OUTPUT_TEXTURE);
    vec2 uv = (vec2(pixel) + 0.5) / image_size;

	if (textureLod(tex, uv,0.0).a == 0.0) {
		return;
	}

	vec3 color = vec3(0.0);
	float weight = 0.0;
	for(int y = -radius; y < radius+1; y++) {
		for(int x = -radius; x < radius+1; x++) {
			vec4 col = textureLod(tex, uv + vec2(x, y) / image_size, 0.0);
			color += col.rgb * col.a;
			weight += col.a;
		}
	}
	imageStore(OUTPUT_TEXTURE, pixel, vec4(color / weight, 1.0));
}"
